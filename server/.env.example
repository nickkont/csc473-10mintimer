PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Path to Firebase Admin service account JSON.
# Download from Firebase Console: Project Settings → Service Accounts → Generate new private key.
# Save the JSON file to server/serviceAccount.json (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Set to "false" to disable the price ticker (no automatic market price movement).
PRICE_TICK_ENABLED=true

# Set to "false" to disable bot traders (no automated bets every 15s).
BOT_TRADER_ENABLED=true
